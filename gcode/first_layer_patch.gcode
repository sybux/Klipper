; ==== TEST PREMIERE COUCHE - patch plein ====
; Genere par gen_calibration_gcode.py
; buse 215 C / plateau 60 C
; couche 0.2 mm / largeur 0.45 mm
; Patch plein 80 x 80 mm, une seule couche.
; Surface lisse et sans creux entre les lignes = Z offset correct.
; Duree indicative : 8-12 min.

M104 S175 ; prechauffe buse (sans attendre)
M190 S60 ; plateau et attente
G28
M109 S215 ; buse et attente
G90 ; positions absolues
M83 ; extrusion relative
G92 E0
M106 S102 ; ventilateur de couche 40%

SET_PRESSURE_ADVANCE ADVANCE=0

; --- ligne de purge ---
G1 Z2.20 F900
G1 X5.00 Y6.00 F6000
G1 Z0.200 F600
G1 E4 F300 ; amorcage
G1 X105.00 Y6.00 E5.2385 F1200
G1 Y6.45 E0.0236 F1200
G1 X5.00 Y6.45 E5.2385 F1500
G1 E-0.6 F2100 ; retract
G1 Z3.20 F900
G92 E0

